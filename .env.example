# Environment configuration template for PRESCPTR
# Rename this file to .env or export variables directly in your host shell.
# DO NOT commit real API keys or tokens to git.

# Google AI Studio API Key for Gemini inference (Host environment only - NEVER pass into sandbox)
GEMINI_API_KEY=your_google_ai_studio_api_key_here

# Selected Gemini model ID (e.g., gemini-2.5-flash)
GEMINI_MODEL=gemini-2.5-flash

# Control Plane Service Port (Default: 8765)
CONTROL_PLANE_PORT=8765
CONTROL_PLANE_BIND=0.0.0.0

# Base URL reachable by OpenShell sandboxes (host-gateway)
BASE_URL=http://host.openshell.internal:8765

# Rate Spacing (minimum interval in seconds between inference calls)
INFERENCE_INTERVAL=15

# Rolling 24-hour inference budget cap
DAILY_REQUESTS_CAP=100
